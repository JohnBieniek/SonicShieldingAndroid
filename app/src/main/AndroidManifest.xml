<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_tight"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonicShielding">

        <activity
            android:name=".ComfortProfileActivity"
            android:exported="true"
            android:label="@string/comfort_profile"
            android:parentActivityName=".ToggleActivity" />

        <activity
            android:name=".ToggleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.SonicShielding.Transparent" />

        <activity-alias
            android:name=".ShieldOff"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/logo_inactive"
            android:label="@string/app_name"
            android:targetActivity=".ToggleActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".ShieldOn"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/logo_tight"
            android:label="@string/app_name"
            android:targetActivity=".ToggleActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <service
            android:name=".ShieldTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
